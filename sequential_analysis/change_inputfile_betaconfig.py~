#!/usr/bin/env python3

import sys
import re

def change_input_filename(line_number, input_file_list="run_list.txt", config_file="../beta_config.ini", output_file_path="/media/tb_pc/Elements/TB8_transfer/stats/"):
    """
    Changes the input_filename line in the betaconfig.ini file
    with the content of a specific line from the input_files.txt file.

    Args:
        line_number (int): The line number in the input_files.txt
                           to use as the new input filename.
        input_file_list (str, optional): Path to the text file containing
                                         the list of input filenames.
                                         Defaults to "input_files.txt".
        config_file (str, optional): Path to the betaconfig.ini file
                                     to be edited. Defaults to "betaconfig.ini".
    """
    try:
        line_number = int(line_number)
    except ValueError:
        print("Error: Invalid line number provided.")
        sys.exit(1)

    try:
        with open(input_file_list, 'r') as f_list:
            input_filenames = f_list.readlines()
    except FileNotFoundError:
        print(f"Error: Input file list '{input_file_list}' not found.")
        sys.exit(1)

    if not 1 <= line_number <= len(input_filenames):
        print(f"Error: Line number {line_number} is out of range for '{input_file_list}'.")
        sys.exit(1)

    new_input_filename = input_filenames[line_number - 1].strip()
    run_number = int(re.search(r'Run(\d+)_', new_input_filename).group(1)) #assumes a certain format of the input line 
    new_output_filename = output_file_path+f"run_{int((run_number// 100) * 100)}/stats_{run_number}_Tracks_DUT_new-code.root"
    updated_lines = []

    try:
        with open(config_file, 'r') as f_config:
            for i, line in enumerate(f_config):
                if i == 1:  # The line to change (second line, index 1)
                    updated_lines.append(f"input_filename={new_input_filename}\n")
                else:
                    if i == 2:
                        updated_lines.append(f"output_filename={new_output_filename}\n")
                    else:
                        updated_lines.append(line)
    except FileNotFoundError:
        print(f"Error: Configuration file '{config_file}' not found.")
        sys.exit(1)

    try:
        with open(config_file, 'w') as f_config:
            f_config.writelines(updated_lines)
        print(f"Successfully changed the input filename in '{config_file}' to '{new_input_filename}'.")
    except IOError:
        print(f"Error: Could not write to the configuration file '{config_file}'.")
        sys.exit(1)

if __name__ == "__main__":
    if len(sys.argv) != 2:
        print("Usage: python3 change_inputfile_betaconfig.py <line_number>")
        sys.exit(1)

    line_number = sys.argv[1]
    change_input_filename(line_number)
